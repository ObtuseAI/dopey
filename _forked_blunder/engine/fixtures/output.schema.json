{
  "$schema": "blunder/minimal-subset",
  "title": "Blunder Fixture Summary Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_count", "total", "max", "min", "mean", "checksum"],
  "properties": {
    "record_count": { "type": "integer", "minimum": 0 },
    "total": { "type": "number" },
    "max": { "type": "number" },
    "min": { "type": "number" },
    "mean": { "type": "number" },
    "checksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
